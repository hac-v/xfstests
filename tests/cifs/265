#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: CIFS_IOC_SHUTDOWN — graceful filesystem shutdown ioctl
#
# Kernel code exercised:
# - ioctl.c:586: CIFS_IOC_SHUTDOWN handler
# - cifs_shutdown() in cifsfs.c
# - Exercises the controlled shutdown path
#
# Note: This ioctl is dangerous on a live mount, so we test it on a
# secondary mount that we can afford to lose, then verify cleanup.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ "$(id -u)" = 0 ] || _notrun "root required"

command -v python3 >/dev/null 2>&1 || _notrun "requires python3"

# We test on a secondary mount to avoid killing the primary test mount
M1=""
_cleanup_265() {
    [ -n "$M1" ] && umount -l "$M1" 2>/dev/null || true
    [ -n "$M1" ] && rmdir "$M1" 2>/dev/null || true
}
_register_cleanup _cleanup_265

_test_unmount >/dev/null 2>&1

BASE=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^\s*-o\s*//')

M1=$(mktemp -d /tmp/cifs265.XXXXXX) || _fail "mktemp failed"
if ! _do "mount -t cifs '$TEST_DEV' '$M1' -o '$BASE'" 2>>"$seqres.full"; then
    rmdir "$M1" 2>/dev/null; M1=""
    _fail "secondary mount failed"
fi

# Write some data first
SUB="cifs265.$$.d"
mkdir -p "$M1/$SUB" || _fail "mkdir workspace failed"
echo "pre_shutdown" > "$M1/$SUB/test" || _fail "write failed"
sync

# Test CIFS_IOC_SHUTDOWN ioctl
# CIFS_IOC_SHUTDOWN = _IOR('X', 125, __u32)  -- same as XFS/ext4 shutdown
python3 -c "
import fcntl, struct, os, sys, errno

# FS_IOC_SHUTDOWN = _IOR('X', 125, __u32) = 0x8004587d
FS_IOC_SHUTDOWN = 0x8004587d
# Alternative: CIFS_IOC_SHUTDOWN might be _IO(0xcf, ...) — try both
CIFS_IOC_SHUTDOWN_ALT = 0x0000cf10

fd = os.open('$M1/$SUB/test', os.O_RDONLY)
try:
    # SHUTDOWN_FLAG_FS_GOING_DOWN = 0x0
    buf = struct.pack('I', 0)
    try:
        fcntl.ioctl(fd, FS_IOC_SHUTDOWN, buf)
        print('FS_IOC_SHUTDOWN succeeded', file=sys.stderr)
    except OSError as e:
        if e.errno in (errno.EOPNOTSUPP, errno.ENOTTY, errno.EINVAL):
            print(f'FS_IOC_SHUTDOWN not supported: {e}', file=sys.stderr)
            # Try alt
            try:
                fcntl.ioctl(fd, CIFS_IOC_SHUTDOWN_ALT, buf)
                print('CIFS_IOC_SHUTDOWN alt succeeded', file=sys.stderr)
            except OSError as e2:
                print(f'CIFS_IOC_SHUTDOWN alt: {e2}', file=sys.stderr)
                sys.exit(77)
        else:
            print(f'FS_IOC_SHUTDOWN error: {e}', file=sys.stderr)
            sys.exit(77)
finally:
    os.close(fd)
" 2>>"$seqres.full"
rc=$?

if [ $rc -eq 77 ]; then
    echo "cifs265: [skip] SHUTDOWN ioctl not supported" >> "$seqres.full"
else
    echo "cifs265: SHUTDOWN ioctl invoked" >> "$seqres.full"

    # After shutdown, I/O to the mount should fail
    if echo "post_shutdown" > "$M1/$SUB/test2" 2>/dev/null; then
        echo "cifs265: [note] write after shutdown succeeded (may be buffered)" >> "$seqres.full"
    else
        echo "cifs265: write correctly blocked after shutdown" >> "$seqres.full"
    fi
fi

# Clean unmount of the shutdown mount
umount -l "$M1" 2>>"$seqres.full" || true
rmdir "$M1" 2>/dev/null || true
M1=""

# Remount primary for test framework cleanup
_do "_test_mount" 2>>"$seqres.full" || true

echo "CIFS_IOC_SHUTDOWN OK"

status=0
exit
