#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: advisory locking (flock) basic semantics
#
# Behavior under test
# - flock(LOCK_EX|LOCK_NB) on same file in another process must fail with EWOULDBLOCK.
# - Releasing the lock allows the second process to acquire it.
#
# Output
# - Stable single success line; diagnostics go to $seqres.full.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_register_cleanup "_test_unmount >/dev/null 2>&1; rm -rf \"$TEST_DIR/cifs114.$$\" >/dev/null 2>&1"

_test_unmount > /dev/null 2>&1
_do "_test_mount" || _fail "mount failed"

W="$TEST_DIR/cifs114.$$"
mkdir -p "$W" || _fail "mkdir workspace failed"
touch "$W/lockfile" || _fail "create file failed"

# Acquire exclusive lock in this process
exec 3>"$W/lockfile" || _fail "open lockfile failed"
flock -n 3 2>>$seqres.full || _fail "initial flock -n failed"

# Try to acquire lock from a subshell non-blocking; expect failure
if bash -c "exec 4> '$W/lockfile'; flock -n 4" >/dev/null 2>>$seqres.full; then
    _fail "second flock unexpectedly succeeded while lock held"
fi

# Release and verify second process can acquire
exec 3>&-
if ! bash -c "exec 5> '$W/lockfile'; flock -n 5" >/dev/null 2>>$seqres.full; then
    _fail "second flock failed after release"
fi

echo "flock basic OK"

status=0
exit
