# --- Test 5: edge cases — zero-width, combining chars ---
python3 -c "
import os, sys

d = '$W'
edge = {
    'combining_accent': 'e\u0301file',  # e + combining acute = é
    'zero_width_joiner': 'a\u200Db',    # a + ZWJ + b
    'bom_in_name': '\uFEFFbom_file',    # BOM character
    'rtl_override': '\u202Ertl_file',   # RTL override
}

ok = 0
for label, name in edge.items():
    try:
        path = os.path.join(d, name)
        with open(path, 'w') as f:
            f.write(label)
        # Read back
        with open(path, 'r') as f:
            data = f.read()
        assert data == label, f'{label}: {data!r}'
        ok += 1
    except OSError as e:
        print(f'{label}: {e}', file=sys.stderr)

print(f'edge cases: {ok}/{len(edge)} passed', file=sys.stderr)
" 2>>"$seqres.full" || true  # edge cases may fail, that's informational

echo "cifs267: edge cases done" >> "$seqres.full"

# --- Test 6: long unicode name (near SMB MAX_PATH) ---
python3 -c "
import os, sys

d = '$W'
# SMB max filename component is ~255 chars; try 200 unicode chars
long_name = '文' * 100  # 100 CJK chars = 300 UTF-8 bytes, 200 UTF-16 bytes
try:
    path = os.path.join(d, long_name)
    with open(path, 'w') as f:
        f.write('long_unicode')
    with open(path, 'r') as f:
        assert f.read() == 'long_unicode'
    print(f'long unicode ({len(long_name)} chars) OK', file=sys.stderr)
except OSError as e:
    print(f'long unicode: {e}', file=sys.stderr)
" 2>>"$seqres.full" || true

echo "cifs267: long unicode done" >> "$seqres.full"

# --- Test 7: readdir returns all unicode files correctly ---
python3 -c "
import os, sys

d = '$W'
entries = os.listdir(d)
print(f'total entries: {len(entries)}', file=sys.stderr)
# We created ~25+ files across all tests; verify reasonable count
assert len(entries) >= 15, f'readdir too few: {len(entries)}'
" 2>>"$seqres.full" || _fail "unicode readdir count failed"

echo "unicode/i18n filename stress OK"

status=0
exit
