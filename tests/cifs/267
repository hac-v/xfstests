#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: Unicode / i18n filename stress
#
# Kernel code exercised:
# - cifs_unicode.c (645 lines): cifs_from_utf16(), cifs_utf16_bytes(),
#   cifs_strtoUTF16(), UniStrnlen(), UniToupper()
# - dir.c: cifs_lookup(), cifs_create(), cifs_mkdir() with unicode names
# - readdir.c: parsing unicode filenames from QUERY_DIRECTORY responses
#
# Tests CJK characters, emoji (4-byte UTF-8), Cyrillic, Arabic, mixed scripts,
# zero-width characters, NFC/NFD forms, and names near the SMB path limit.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

command -v python3 >/dev/null 2>&1 || _notrun "requires python3"

W="$TEST_DIR/cifs267.$$"
_register_cleanup "rm -rf '$W' >/dev/null 2>&1 || true"
mkdir -p "$W" || _fail "mkdir workspace failed"

# --- Test 1: CJK characters (Chinese, Japanese, Korean) ---
python3 -c "
import os, sys

d = '$W'
names = {
    'chinese': '中文测试文件',
    'japanese': 'テスト日本語ファイル',
    'korean': '한국어테스트파일',
    'mixed_cjk': '中文_テスト_한국어',
}

for label, name in names.items():
    path = os.path.join(d, name)
    try:
        with open(path, 'w') as f:
            f.write(f'content_{label}')
        # Read back
        with open(path, 'r') as f:
            data = f.read()
        assert data == f'content_{label}', f'{label}: read {data!r}'
        # Verify via listdir
        assert name in os.listdir(d), f'{label}: not in listdir'
        print(f'{label} OK', file=sys.stderr)
    except OSError as e:
        print(f'{label} SKIP: {e}', file=sys.stderr)
" 2>>"$seqres.full" || _fail "CJK test failed"

echo "cifs267: CJK OK" >> "$seqres.full"

# --- Test 2: Emoji (4-byte UTF-8 / surrogate pairs in UTF-16) ---
python3 -c "
import os, sys

d = '$W'
emoji_names = [
    '🎉party',
    'fire🔥file',
    '🇺🇸flag',
    '❤️heart',
    '🏠home_dir',
    '🎵🎶music',
]

ok = 0
for name in emoji_names:
    path = os.path.join(d, name)
    try:
        with open(path, 'w') as f:
            f.write('emoji_data')
        with open(path, 'r') as f:
            assert f.read() == 'emoji_data'
        ok += 1
    except OSError as e:
        print(f'emoji {name!r}: {e}', file=sys.stderr)

print(f'emoji: {ok}/{len(emoji_names)} passed', file=sys.stderr)
assert ok >= 1, 'no emoji filenames worked'
" 2>>"$seqres.full" || _fail "emoji test failed"

echo "cifs267: emoji OK" >> "$seqres.full"

