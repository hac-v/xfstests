#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: try multiple vers= options (1.0, 2.0, 2.1, 3.0, 3.1.1), verify negotiated dialect
# Also mount once with no vers= and warn (not fail) if dialect < 3.1.1.
# Per-version details are logged to $seqres.full; stdout stays stable.
#
# Copyright (C) 2025 Your Name

. ./common/preamble
_begin_fstest auto quick

# CIFS-only and require env
[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

host_from_test_dev()
{
    echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\\1#'
}

share_from_test_dev()
{
    echo "$TEST_DEV" | sed -E 's#^//[^/]+/([^/]+).*#\\1#'
}

unc_from_test_dev()
{
    local h=$(host_from_test_dev)
    local s=$(share_from_test_dev)
    # Return UNC in the form \\host\share
    printf "\\\\%s\\%s" "$h" "$s"
}

# Return a list of "<connid> <hostname>" for our host from a DebugData snapshot
list_conns_for_host()
{
    local snap="$1"
    local host="$2"
    echo "$snap" | awk -v H="$host" '
        /ConnectionId:/ {
            cid=""; h=""
            for (i=1;i<=NF;i++) {
                if ($i ~ /^ConnectionId:/) cid=$(i+1)
                if ($i ~ /^Hostname:/) h=$(i+1)
            }
            if (h==H) print cid, h
        }'
}

## Given a snapshot and UNC, find the connection block that references that share
## and return its Dialect line.
get_dialect_for_share()
{
    local snap="$1"
    local unc="$2"
    echo "$snap" | awk -v UNC="$unc" '
        # Track state for current connection block
        /ConnectionId:/ {
            if (have_prev && prev_share_hit==1) { print prev_dialect; exit }
            have_prev=1; prev_share_hit=0; prev_dialect=""; in_conn=1
        }
        in_conn && /Dialect / { if (prev_dialect == "") prev_dialect=$0 }
        in_conn {
            if (index($0, UNC) > 0) { prev_share_hit=1 }
        }
        # Heuristic end of connection block: blank line preceding a new section
        NF==0 { in_conn=0 }
        END { if (prev_share_hit==1) print prev_dialect }
    '
}

verify_dialect_match()
{
    local vers="$1"
    local dialect_line="$2"
    case "$vers" in
        "3.1.1") echo "$dialect_line" | grep -q "Dialect 0x311" ;;
        "3.0")   echo "$dialect_line" | grep -Eq "Dialect 0x300|Dialect 0x302" ;;
        "2.1")   echo "$dialect_line" | grep -q "Dialect 0x210" ;;
        "2.0")   echo "$dialect_line" | grep -q "Dialect 0x202" ;;
        "1.0")   # SMB1 DebugData format varies; accept mount success
            return 0 ;;
        *) return 1 ;;
    esac
}

# Extract numeric dialect code (e.g., 0x311) from a "Dialect ..." line
dialect_code_from_line()
{
    local line="$1"
    echo "$line" | sed -n 's/.*Dialect[[:space:]]\+\(0x[0-9A-Fa-f]\+\).*/\1/p'
}

run_one()
{
    local vers="$1"
    local host="$2"
    local unc=$(unc_from_test_dev)

    # Try mount with nosharesock to avoid reusing sockets
    _do "_test_mount -o vers=$vers,nosharesock"
    if [ $? -ne 0 ]; then
        echo "vers=$vers: mount failed" >> $seqres.full
        return 0
    fi
    _register_cleanup "_test_unmount"

    local post=$(cat /proc/fs/cifs/DebugData)
    local dialect_line=$(get_dialect_for_share "$post" "$unc")

    if [ -z "$dialect_line" ]; then
        echo "vers=$vers: could not find dialect line" >> $seqres.full
        _test_unmount
        return 0
    fi

    if verify_dialect_match "$vers" "$dialect_line"; then
        echo "vers=$vers OK: $dialect_line" >> $seqres.full
    else
        echo "vers=$vers MISMATCH: $dialect_line" >> $seqres.full
        _fail "Dialect mismatch for vers=$vers"
    fi

    _test_unmount
}

run_default()
{
    # Mount with no explicit vers=; expect negotiated dialect >= 0x311, else warn
    local host="$1"
    local unc=$(unc_from_test_dev)

    _do "_test_mount -o nosharesock"
    if [ $? -ne 0 ]; then
        echo "default: mount failed" >> $seqres.full
        return 0
    fi
    _register_cleanup "_test_unmount"

    local post=$(cat /proc/fs/cifs/DebugData)
    local dialect_line=$(get_dialect_for_share "$post" "$unc")

    if [ -z "$dialect_line" ]; then
        echo "default: could not find dialect line" >> $seqres.full
        _test_unmount
        return 0
    fi

    local code=$(dialect_code_from_line "$dialect_line")
    if awk "BEGIN { exit !(strtonum(\"$code\") >= strtonum(\"0x311\")) }"; then
        echo "default OK: $dialect_line" >> $seqres.full
    else
        echo "default MISMATCH: $dialect_line" >> $seqres.full
        echo "WARNING: Default CIFS mount negotiated a dialect older than SMB 3.1.1." >> $seqres.full
        echo "Default CIFS mount negotiated < SMB 3.1.1; consider setting vers=3.1.1 explicitly." >> $seqres.hints
    fi

    _test_unmount
}

main()
{
    local host=$(host_from_test_dev)
    local versions=(1.0 2.0 2.1 3.0 3.1.1)
    local tried=0
    for v in "${versions[@]}"; do
        run_one "$v" "$host"
        tried=$((tried+1))
    done
    # Also verify default (no vers specified) negotiates >= 3.1.1 (warn if not)
    run_default "$host"
    # Print stable line for .out
    echo "Versions processed"
}

main
status=0
exit
exit
