#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: ensure no leaked open files after close + unmount burst
#
# Summary
#   Mount the share on a temporary mountpoint, rapidly open and close a batch
#   of files, unmount immediately, and confirm /proc/fs/cifs/open_files no
#   longer reports handles for that share. This guards against latent handle
#   leaks in the close/unmount path.
#
# Phases
#   1. Record the baseline count of open file records for the target share.
#   2. Mount the share to a temp directory (skip if prerequisites missing).
#   3. Create and open/close N files in a dedicated subdirectory.
#   4. Unmount the share and re-sample open_files.
#   5. Fail if the post-unmount count exceeds the baseline.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/open_files ] || _notrun "open_files interface unavailable"

host=$(echo "$TEST_DEV" | sed -n 's#^//\([^/]*\)/.*#\1#p')
share=$(echo "$TEST_DEV" | sed -n 's#^//[^/]*/\([^/]*\).*#\1#p')
[ -n "$host" ] || _notrun "parse host failed"
[ -n "$share" ] || _notrun "parse share failed"

pattern="\\\\$host\\$share"
baseline=$(grep -F "$pattern" /proc/fs/cifs/open_files 2>/dev/null | wc -l)

MNT=$(mktemp -d /tmp/cifs190.mnt.XXXXXX) || _fail "mktemp"

cleanup()
{
    if mountpoint -q "$MNT"; then
        umount "$MNT" >/dev/null 2>&1 || true
    fi
    rmdir "$MNT" >/dev/null 2>&1 || true
}
_register_cleanup cleanup

base_opts=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^[[:space:]]*-o[[:space:]]*//' -e 's/^[[:space:]]*//')
if [ -z "$base_opts" ]; then
    base_opts=$(awk -v mnt="$TEST_DIR" '$2==mnt {print $4}' /proc/mounts)
fi
if ! echo "$base_opts" | grep -Eq '(^|,)(credentials=|username=|user=)'; then
    if [ -n "$CIFS_CRED_FILE" ] && [ -r "$CIFS_CRED_FILE" ]; then
        base_opts="${base_opts:+$base_opts,}credentials=$CIFS_CRED_FILE"
    elif [ -r /root/.cifs-cred-xfstest ]; then
        base_opts="${base_opts:+$base_opts,}credentials=/root/.cifs-cred-xfstest"
    elif [ -n "$CIFS_USER" ] && [ -n "$CIFS_PASS" ]; then
        base_opts="${base_opts:+$base_opts,}username=$CIFS_USER,password=$CIFS_PASS"
    fi
fi

if ! mount -t cifs "$TEST_DEV" "$MNT" -o "$base_opts" >>$seqres.full 2>&1; then
    rmdir "$MNT" >/dev/null 2>&1 || true
    _fail "temporary mount failed"
fi

WORKDIR="$MNT/cifs190"
mkdir -p "$WORKDIR" || _fail "create workdir"

COUNT=${CIFS190_FILES:-100}

for i in $(seq 1 $COUNT); do
    f="$WORKDIR/file$i"
    : > "$f" || _fail "touch $f"
    exec {fd}<>"$f" || _fail "open $f"
    printf 'x' >&$fd || _fail "write $f"
    eval "exec ${fd}>&-"
done

sync

umount "$MNT" >>$seqres.full 2>&1 || _fail "umount failed"
sleep 1

after=$(grep -F "$pattern" /proc/fs/cifs/open_files 2>/dev/null | wc -l)

if [ "$after" -gt "$baseline" ]; then
    echo "cifs190: baseline=$baseline after=$after pattern=$pattern" >>$seqres.full
    _fail "open file entries persisted after unmount"
fi

echo "No lingering open files after close + unmount OK"
status=0
exit
