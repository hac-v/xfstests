#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: remount transitions enforce read-only semantics
#
# Validates that:
#   1. A share mounted read-write can be remounted read-only and begins
#      rejecting write operations immediately.
#   2. A share mounted read-only can be remounted read-write and resumes
#      allowing writes.
#
# We use a dedicated subdirectory under the existing test mount, relying on
# fake remounts to avoid impacting the user's primary configuration.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ "$(id -u)" = 0 ] || _notrun "root required"

# Ensure we have mount options string from /proc/mounts.
mount_line=$(awk -v mnt="$TEST_DIR" '$2==mnt {print; exit}' /proc/mounts)
[ -n "$mount_line" ] || _notrun "mount entry not found"
orig_opts=$(echo "$mount_line" | awk '{print $4}')

WORK="cifs195.$$.dir"
TEST_PATH="$TEST_DIR/$WORK"
mkdir -p "$TEST_PATH" || _fail "mkdir test path"
_register_cleanup "rm -rf '$TEST_PATH' >/dev/null 2>&1 || true"

# Helper to remount and restore original options afterwards.
restore_mount() {
    mount -o "remount,$orig_opts" "$TEST_DIR" >/dev/null 2>&1 || true
}
_register_cleanup restore_mount

# Phase 1: start RW -> remount ro -> expect writes fail
mangle_file="$TEST_PATH/rw_then_ro.txt"

printf 'seed' >"$mangle_file" || _fail "initial write failed"

if ! mount -o remount,ro "$TEST_DIR" >>$seqres.full 2>&1; then
    _notrun "remount ro unsupported"
fi

# Ensure write rejection
errf1=${TMPDIR:-/tmp}/cifs195.err1.$$ 
if printf 'more' 2>"$errf1" >>"$mangle_file"; then
    cat "$errf1" >>$seqres.full 2>/dev/null || true
    rm -f "$errf1"
    _fail "write succeeded after remount ro"
fi
rm -f "$errf1"

# Phase 2: remount back to original options (assumed rw)
if ! mount -o remount,"$orig_opts" "$TEST_DIR" >>$seqres.full 2>&1; then
    _fail "remount to original options failed"
fi

# Verify write works again
if ! printf 'again' >>"$mangle_file"; then
    _fail "write failed after remount rw"
fi

# Phase 3: explicitly start ro -> remount rw -> verify writes allowed
# Need to remount ro first, then back to rw to confirm both directions.
if ! mount -o remount,ro "$TEST_DIR" >>$seqres.full 2>&1; then
    _notrun "second remount ro unsupported"
fi

errf2=${TMPDIR:-/tmp}/cifs195.err2.$$ 
if printf 'nope' 2>"$errf2" >>"$mangle_file"; then
    cat "$errf2" >>$seqres.full 2>/dev/null || true
    rm -f "$errf2"
    _fail "write succeeded after second remount ro"
fi
rm -f "$errf2"

if ! mount -o remount,"$orig_opts" "$TEST_DIR" >>$seqres.full 2>&1; then
    _fail "remount rw after ro failed"
fi

if ! printf 'final' >>"$mangle_file"; then
    _fail "write failed after final remount rw"
fi

echo "remount ro/rw transitions enforce semantics"
status=0
exit
