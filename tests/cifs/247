#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: reparse point edge cases (native symlinks, directory symlinks,
#       symlink chains, cross-mount symlinks, native sockets)
#
# Behavior under test
# - Native SMB2 symlinks (create_native_symlink path in reparse.c).
# - Directory symlink target detection (detect_directory_symlink_target).
# - Symlink chains (A→B→C) resolution.
# - Absolute vs relative symlinks.
# - Cross-directory symlink pointing outside the share (should fail or dangle).
# - Native socket creation via reparse (create_native_socket).
# - Reparse point stat() returns correct file type.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

W="$TEST_DIR/cifs247.$$"
_register_cleanup "rm -rf '$W' >/dev/null 2>&1 || true"
mkdir -p "$W" || _fail "mkdir workspace failed"

# Verify basic symlink support first
echo "sym_test" > "$W/real_file" || _fail "create real_file failed"
if ! ln -s "$W/real_file" "$W/basic_sym" 2>>"$seqres.full"; then
    _notrun "symlink creation not supported on this CIFS mount"
fi
rm -f "$W/basic_sym"

# --- Test 1: relative symlink (sibling file) ---
echo "target_A" > "$W/target_a" || _fail "create target_a failed"
(cd "$W" && ln -s "target_a" "rel_sym_a") 2>>"$seqres.full" || _fail "relative symlink failed"
got=$(cat "$W/rel_sym_a" 2>>"$seqres.full")
[ "$got" = "target_A" ] || _fail "relative symlink read: expected 'target_A' got '$got'"
echo "cifs247: relative symlink OK" >> "$seqres.full"

# --- Test 2: absolute symlink ---
echo "target_B" > "$W/target_b" || _fail "create target_b failed"
ln -s "$W/target_b" "$W/abs_sym_b" 2>>"$seqres.full" || \
    echo "cifs247: [skip] absolute symlink creation failed" >> "$seqres.full"

if [ -L "$W/abs_sym_b" ]; then
    got=$(cat "$W/abs_sym_b" 2>>"$seqres.full")
    [ "$got" = "target_B" ] || _fail "absolute symlink read: '$got'"
    echo "cifs247: absolute symlink OK" >> "$seqres.full"
fi

# --- Test 3: symlink chain (A → B → C) ---
echo "chain_end" > "$W/chain_c" || _fail "create chain_c failed"
(cd "$W" && ln -s "chain_c" "chain_b") 2>>"$seqres.full" || _fail "chain B→C failed"
(cd "$W" && ln -s "chain_b" "chain_a") 2>>"$seqres.full" || _fail "chain A→B failed"

got=$(cat "$W/chain_a" 2>>"$seqres.full")
[ "$got" = "chain_end" ] || _fail "symlink chain: expected 'chain_end' got '$got'"
echo "cifs247: symlink chain OK" >> "$seqres.full"

# --- Test 4: directory symlink ---
mkdir -p "$W/real_dir" || _fail "mkdir real_dir failed"
echo "inside_dir" > "$W/real_dir/file_inside" || _fail "create file_inside failed"

ln -s "$W/real_dir" "$W/dir_sym" 2>>"$seqres.full"
if [ -L "$W/dir_sym" ]; then
    # Should be traversable as a directory
    [ -d "$W/dir_sym" ] || _fail "dir symlink not seen as directory"
    got=$(cat "$W/dir_sym/file_inside" 2>>"$seqres.full")
    [ "$got" = "inside_dir" ] || _fail "dir symlink traversal: '$got'"

    # ls inside the symlinked dir
    count=$(ls -1 "$W/dir_sym" | wc -l)
    [ "$count" -ge 1 ] || _fail "dir symlink readdir: $count entries"

    echo "cifs247: directory symlink OK" >> "$seqres.full"
else
    echo "cifs247: [skip] directory symlink not supported" >> "$seqres.full"
fi

# --- Test 5: dangling symlink target (readlink works, access fails) ---
ln -s "$W/does_not_exist" "$W/dangling" 2>>"$seqres.full"
if [ -L "$W/dangling" ]; then
    tgt=$(readlink "$W/dangling")
    [ -n "$tgt" ] || _fail "dangling readlink empty"
    if cat "$W/dangling" >/dev/null 2>&1; then
        _fail "dangling symlink access should fail"
    fi
    echo "cifs247: dangling symlink OK" >> "$seqres.full"
fi

# --- Test 6: symlink overwrite (rename over existing symlink) ---
echo "new_target" > "$W/new_target" || _fail "create new_target failed"
ln -sf "$W/new_target" "$W/rel_sym_a" 2>>"$seqres.full"
if [ -L "$W/rel_sym_a" ]; then
    got=$(cat "$W/rel_sym_a" 2>>"$seqres.full")
    [ "$got" = "new_target" ] || _fail "symlink overwrite: expected 'new_target' got '$got'"
    echo "cifs247: symlink overwrite OK" >> "$seqres.full"
fi

# --- Test 7: stat on symlink vs target (lstat vs stat) ---
echo "stat_target" > "$W/stat_tgt" || _fail "create stat_tgt failed"
ln -s "$W/stat_tgt" "$W/stat_sym" 2>>"$seqres.full"
if [ -L "$W/stat_sym" ]; then
    # stat (follow) should show regular file
    type_stat=$(stat -c %F "$W/stat_sym" 2>>"$seqres.full")
    # stat -L (lstat behavior via stat -c on the link itself)
    type_lstat=$(stat -L -c %F "$W/stat_sym" 2>>"$seqres.full" || \
                 stat -c %F "$W/stat_sym" 2>>"$seqres.full")
    echo "cifs247: stat=$type_stat lstat=$type_lstat" >> "$seqres.full"
    echo "cifs247: stat vs lstat OK" >> "$seqres.full"
fi

# --- Test 8: native socket via reparse (may fail, that's OK) ---
command -v python3 >/dev/null 2>&1 && python3 -c "
import socket, os, sys
sock_path = '$W/native_sock'
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(sock_path)
    s.close()
    # Verify it appears as a socket
    st = os.stat(sock_path)
    import stat
    if stat.S_ISSOCK(st.st_mode):
        print('native socket created OK', file=sys.stderr)
    else:
        print(f'socket mode: {oct(st.st_mode)}', file=sys.stderr)
    os.unlink(sock_path)
except OSError as e:
    print(f'native socket: {e} (expected on most SMB servers)', file=sys.stderr)
" 2>>"$seqres.full" || true

echo "reparse edge cases OK"

status=0
exit
