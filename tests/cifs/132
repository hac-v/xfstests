#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: noserverino inode may change across remounts

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"

_register_cleanup "_test_unmount >/dev/null 2>&1"
_test_unmount >/dev/null 2>&1

MO=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^\s*-o\s*//')
MO=$(echo "$MO" | awk -F, '{out=""; for(i=1;i<=NF;i++){ if($i=="serverino"||$i=="noserverino") continue; out=out (out?"," : "") $i } print out}')
[ -n "$MO" ] && MO="$MO,noserverino" || MO="noserverino"

MNT=$(mktemp -d /tmp/cifs132.XXXXXX) || _fail "mktemp failed"

_do "mount -t cifs '$TEST_DEV' '$MNT' -o '$MO'" || _fail "mount1 failed"
SUB="cifs132.$$.d"; _do "mkdir -p '$MNT/$SUB'" || _fail "mkdir failed"
F="$MNT/$SUB/f"; echo x > "$F" || _fail "create failed"
i1=$(stat -c %i "$F") || _fail "stat i1 failed"
_do "umount -l '$MNT'" || true

_do "mount -t cifs '$TEST_DEV' '$MNT' -o '$MO'" || _fail "mount2 failed"
i2=$(stat -c %i "$F") || _fail "stat i2 failed"

if [ "$i1" != "$i2" ]; then
    echo "noserverino inode changed across remount OK"
else
    echo "noserverino inode remained same; server/client may still return stable inodes" >> $seqres.full
    # Do not fail to avoid false negatives across servers; report OK
    echo "noserverino inode change tolerance OK"
fi

status=0
exit
