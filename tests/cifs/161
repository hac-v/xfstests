#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: default password auth security type should be RawNTLMSSP
# Verifies that a standard username/password mount (no explicit sec=krb5/ntlmv2 override)
# reports "Security type: RawNTLMSSP" for its session in /proc/fs/cifs/DebugData.
# Accepts minor format variation (trailing 'encrypted'). Fails if another
# security type (e.g. Kerberos) unless mount opts explicitly request it.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/DebugData ] || _notrun "no DebugData"

# Skip if sec= specified and not a default password case
mount_line=$(awk -v mnt="$TEST_DIR" '$2==mnt {print; exit}' /proc/mounts)
[ -n "$mount_line" ] || _notrun "mount entry not found"
opts=$(echo "$mount_line" | awk '{print $4}')
if echo "$opts" | grep -qi 'sec=krb'; then _notrun "kerberos mount (different security type)"; fi
if ! echo "$opts" | grep -qi 'username='; then _notrun "no username= (may be creds file)"; fi

host=$(echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\1#')
[ -n "$host" ] || _notrun "parse host failed"
server_ip=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$server_ip" ] || server_ip=""

# Extract Sessions block
sessions=$(awk '/Sessions:/ {flag=1; next} flag && NF==0 {flag=0} flag' /proc/fs/cifs/DebugData)
[ -n "$sessions" ] || _notrun "no sessions block"

# Narrow to session matching server IP (if we resolved it) else first session
if [ -n "$server_ip" ]; then
  sess_chunk=$(echo "$sessions" | awk -v ip="$server_ip" 'BEGIN{capture=0} /Address:/ { if($0 ~ ip){capture=1; print; next} else capture=0 } capture && /Security type:/ {print; exit}')
else
  sess_chunk=$(echo "$sessions" | awk ' /Security type:/ {print; exit}')
fi

sec_line=$(echo "$sess_chunk" | grep -i 'Security type:' || true)
[ -n "$sec_line" ] || _fail "no security type line"
stype=$(echo "$sec_line" | sed -n 's/.*Security type:[[:space:]]*\([^ ]*\).*/\1/p')
[ -n "$stype" ] || _fail "cannot parse type"

echo "cifs161: parsed security type '$stype'" >> $seqres.full
if [ "$stype" != "RawNTLMSSP" ]; then
  _fail "expected RawNTLMSSP got $stype"
fi

echo "default password auth security type OK"
status=0
exit
