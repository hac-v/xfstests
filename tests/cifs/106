#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: verify SMB3 multichannel activates with multichannel mount option
#
# Behavior under test
# - When mounting with -o multichannel (or max_channels), the client should
#   establish multiple transport connections (>=2) to the server if supported.
# - We detect multichannel via /proc/fs/cifs/DebugData "Server interfaces"
#   Allocated channels sum for our host, and also require multiple TCP sockets
#   to the server (port 445/139) to be present at the same time.
#
# Skip policy
# - If DebugData lacks interface info we retry briefly; ultimately this test
#   fails if multichannel is requested but fewer than two channels are visible
#   in both DebugData and sockets for the server.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\%s\\%s" "$h" "$s"; }
_unc_posix() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "//%s/%s" "$h" "$s"; }

HOST=$(_host_from_unc "$TEST_DEV")
UNCW=$(_unc_windows "$TEST_DEV")
UNCP=$(_unc_posix "$TEST_DEV")
SHARE=$(_share_from_unc "$TEST_DEV")
[ -n "$HOST" ] || _notrun "could not derive host"

_dd_effective_channels_for_share()
{
    local host="$1" share="$2"; local snap
    snap=$(cat /proc/fs/cifs/DebugData 2>/dev/null)
    echo "$snap" >> $seqres.full
    echo "$snap" | awk -v HOST="$host" -v SHARE="$share" '
        function finish_block() {
            if (in_block==1 && target==1) {
                eff=sum
                if (extra > 0 && eff < extra + 1)
                    eff=extra + 1
                printf "%d\n", eff
            }
        }
        BEGIN {
            tl=tolower(HOST); sl=tolower(SHARE)
            in_block=0; target=0; in_if=0; sum=0; extra=0
        }
        /^[[:space:]]*[0-9]+[)].*ConnectionId:/ {
            finish_block()
            in_block=1; target=0; in_if=0; sum=0; extra=0; next
        }
        in_block==1 {
            line=tolower($0)
            if (index(line, "\\\\" tl "\\" sl " ")>0 || line ~ ("\\\\" tl "\\" sl "$"))
                target=1
            if ($1=="Extra" && $2=="Channels:") { extra=$3+0 }
            if ($1=="Server" && $2=="interfaces:") { in_if=1; next }
            if (in_if==1 && $1=="Allocated" && $2=="channels:") { n=$3+0; sum+=n }
        }
        END { finish_block() }
    '
}

_resolve_host_ips() { getent ahosts "$1" | awk '{print $1}' | sort -u; }

_tcp_conns_to_host_count()
{
    local host="$1" ips ip
    ips=$(_resolve_host_ips "$host")
    [ -n "$ips" ] || { echo 0; return; }
    if command -v ss >/dev/null 2>&1; then
        ss -tanH 2>/dev/null | awk -v IPS="$(echo $ips)" '
            BEGIN { split(IPS,a," "); }
            { r=$5; if (r ~ /:445$/ || r ~ /:139$/) { for (i in a) if (index(r,a[i])>0) { c++; break } } }
            END { print c+0 }
        '
    else
        netstat -tan 2>/dev/null | sed '1,2d' | awk -v IPS="$(echo $ips)" '
            BEGIN { split(IPS,a," "); }
            { r=$5; if (r ~ /:445$/ || r ~ /:139$/) { for (i in a) if (index(r,a[i])>0) { c++; break } } }
            END { print c+0 }
        '
    fi
}

_register_cleanup "_test_unmount >/dev/null 2>&1; rm -f \"$TEST_DIR/.cifs106.$$\" >/dev/null 2>&1"

# Ensure we explicitly request multichannel
_test_unmount > /dev/null 2>&1
_do "_test_mount -o multichannel" || _fail "mount TEST_DEV with multichannel failed"

# Light I/O to activate the connection
echo 1 > "$TEST_DIR/.cifs106.$$" 2>/dev/null || true

# Poll for DebugData channels (require >=2)
tries=30
sum=""
while [ $tries -gt 0 ]; do
    sum=$(_dd_effective_channels_for_share "$HOST" "$SHARE" | awk 'BEGIN{m=""} {if (m=="" || $1+0>m) m=$1+0} END{if(m!="") print m}')
    echo "multichannel: DebugData sum='${sum}' tries=$tries" >> $seqres.full
    [ -n "$sum" ] && [ "$sum" -ge 2 ] && break
    tries=$((tries-1)); sleep 0.2
done

[ -n "$sum" ] || _fail "DebugData not available for $UNCW"
[ "$sum" -ge 2 ] || _fail "DebugData shows <2 allocated channels (sum=$sum) after requesting multichannel"

# Also require multiple TCP sockets to the server
tries=20
sc=0
while [ $tries -gt 0 ]; do
    sc=$(_tcp_conns_to_host_count "$HOST")
    echo "sockets: count=$sc (tries=$tries)" >> $seqres.full
    [ "$sc" -ge 2 ] && break
    tries=$((tries-1)); sleep 0.3
done

[ "$sc" -ge 2 ] || _fail "TCP sockets to $HOST <2 after requesting multichannel (got $sc)"

# Sockets may be fewer than DebugData channel sum when multiple sessions
# share connections or channels span sessions. Log but don't fail.
if [ "$sc" -lt "$sum" ]; then
    echo "note: TCP sockets ($sc) < DebugData allocated channels ($sum) — sessions may share connections" >> $seqres.full
fi

# If max_channels explicitly specified, usually equal to requested; log if not
req=$(echo "$TEST_FS_MOUNT_OPTS $MOUNT_OPTIONS" | sed -n 's/.*max_channels=\([0-9][0-9]*\).*/\1/p' | head -n1)
if [ -n "$req" ] && [ "$req" -ge 2 ]; then
    if [ "$sum" -ne "$req" ]; then
        echo "note: requested max_channels=$req, DebugData shows sum=$sum (server or NIC limit?)" >> $seqres.full
    fi
fi

echo "Multichannel active (>=2 channels) OK"

status=0
exit
