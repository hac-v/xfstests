#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: Negotiated capabilities (Sessions) — baseline capabilities
#
# Behavior under test
# - Parse Capabilities for our connection from /proc/fs/cifs/DebugData.
# - Parse Sessions Capability (hex) for our connection from /proc/fs/cifs/DebugData.
# - Log all capability flags (DFS, LEASING, LARGE_MTU, MULTICHANNEL,
#   PERSISTENT_HANDLES, DIRECTORY_LEASING, ENCRYPTION, NOTIFICATIONS)
#   for baseline and selected mount options.
# - When nodfs is not used, assert DFS bit is ON in the negotiated mask.
#
# We detect capabilities by matching tokens on the Capabilities line and
# (fallback) decoding its hex bitmask.
#
# Skip policy
# - If DebugData lacks a Capabilities line for our host, skip.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\%s\\%s" "$h" "$s"; }

HOST=$(_host_from_unc "$TEST_DEV")
UNCW=$(_unc_windows "$TEST_DEV")
[ -n "$HOST" ] || _notrun "could not derive host"

_resolve_host_ips() { getent ahosts "$1" | awk '{print $1}' | sort -u; }

_dd_session_caps_bits()
{
    # Input: host; Output: hex dfs lease lmtu mc ph dlease enc notif
    local host="$1" snap ips
    ips=$(_resolve_host_ips "$host")
    [ -n "$ips" ] || { echo ""; return; }
    snap=$(cat /proc/fs/cifs/DebugData 2>/dev/null) || return 2
    echo "$snap" >> $seqres.full
    echo "$snap" | awk -v IPS="$(echo $ips)" '
        BEGIN {
            split(IPS, a, " ");
            hex=""; dfs=lease=lmtu=mc=ph=dlease=enc=notif=0; last_addr=""
        }
        {
            line=$0
            addr=""; cap=""
            if (match(line, /Address:[ ]*([^ ]+)/, m)) addr=m[1]
            if (match(line, /Capability:[ ]*(0x[0-9a-fA-F]+)/, c)) cap=c[1]
            if (addr!="") last_addr=addr
            if (cap=="" && match(line, /Capability:[ ]*(0x[0-9a-fA-F]+)/, c2)) cap=c2[1]
            if (cap!="") {
                if (addr=="") addr=last_addr
                for (i in a) {
                    if (addr==a[i]) {
                        # Decode from rightmost bit: bit0=DFS,1=LEASING,2=LARGE_MTU,3=MULTICHANNEL,4=PERSISTENT_HANDLES,5=DIRECTORY_LEASING,6=ENCRYPTION,7=NOTIFICATIONS
                        hex=cap; v=strtonum(cap)
                        if (and(v, lshift(1,0))) dfs=1
                        if (and(v, lshift(1,1))) lease=1
                        if (and(v, lshift(1,2))) lmtu=1
                        if (and(v, lshift(1,3))) mc=1
                        if (and(v, lshift(1,4))) ph=1
                        if (and(v, lshift(1,5))) dlease=1
                        if (and(v, lshift(1,6))) enc=1
                        if (and(v, lshift(1,7))) notif=1
                        printf "%s %d %d %d %d %d %d %d %d\n", hex, dfs, lease, lmtu, mc, ph, dlease, enc, notif
                        exit
                    }
                }
            }
        }
    '
}

_register_cleanup "_test_unmount >/dev/null 2>&1"

_test_unmount > /dev/null 2>&1

# Baseline mount (log negotiated caps and assert DFS=ON)
if _do "_test_mount"; then
    echo 1 > "$TEST_DIR/.cifs122.$$.base" 2>>$seqres.full || true
    bits=$(_dd_session_caps_bits "$HOST")
    if [ -n "$bits" ]; then
        set -- $bits; echo "baseline caps hex=$1 dfs=$2 lease=$3 lmtu=$4 mc=$5 ph=$6 dlease=$7 enc=$8 notif=$9" >> $seqres.full
        hex=$1; dfs=$2; [ "$dfs" -eq 1 ] || _fail "expected dfs=ON without nodfs (caps=$hex)"
    fi
else
    _fail "baseline mount failed"
fi

_test_unmount > /dev/null 2>&1

# Info-only: nohandlecache (log caps)
if _do "_test_mount -o nohandlecache"; then
    echo 1 > "$TEST_DIR/.cifs122.$$.nohandlecache" 2>>$seqres.full || true
    bits=$(_dd_session_caps_bits "$HOST"); if [ -n "$bits" ]; then set -- $bits; echo "nohandlecache caps hex=$1 dfs=$2 lease=$3 lmtu=$4 mc=$5 ph=$6 dlease=$7 enc=$8 notif=$9" >> $seqres.full; fi
fi
_test_unmount > /dev/null 2>&1

# Info-only: nolease (log caps)
if _do "_test_mount -o nolease"; then
    echo 1 > "$TEST_DIR/.cifs122.$$.nolease" 2>>$seqres.full || true
    bits=$(_dd_session_caps_bits "$HOST"); if [ -n "$bits" ]; then set -- $bits; echo "nolease caps hex=$1 dfs=$2 lease=$3 lmtu=$4 mc=$5 ph=$6 dlease=$7 enc=$8 notif=$9" >> $seqres.full; fi
fi
_test_unmount > /dev/null 2>&1

# Info-only: no multichannel (log caps)
if _do "_test_mount"; then
    echo 1 > "$TEST_DIR/.cifs122.$$.nomc" 2>>$seqres.full || true
    bits=$(_dd_session_caps_bits "$HOST"); if [ -n "$bits" ]; then set -- $bits; echo "nomc caps hex=$1 dfs=$2 lease=$3 lmtu=$4 mc=$5 ph=$6 dlease=$7 enc=$8 notif=$9" >> $seqres.full; fi
fi
_test_unmount > /dev/null 2>&1

echo "Capabilities (baseline) OK"

status=0
exit
