#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: strictsync ensures flush on fsync
. ./common/preamble
. ./common/rc
_begin_fstest auto quick
[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/Stats ] || _notrun "no Stats"
[ "$(id -u)" = 0 ] || _notrun "root remount required"

mount_line=$(awk -v mnt="$TEST_DIR" '$2==mnt {print; exit}' /proc/mounts)
orig_opts=$(echo "$mount_line" | awk '{print $4}')
mount -o remount,strictsync "$TEST_DIR" || _notrun "remount failed"
_register_cleanup "mount -o remount,${orig_opts%%,*} '$TEST_DIR' >/dev/null 2>&1 || true"

stat_before=$(grep -m1 -i 'Flush' /proc/fs/cifs/Stats | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/){print $i; exit}}')
echo data > "$TEST_DIR/strictsync_test.$$"
sync "$TEST_DIR/strictsync_test.$$" 2>/dev/null || true
fsync "$TEST_DIR/strictsync_test.$$" 2>/dev/null || true
stat_after=$(grep -m1 -i 'Flush' /proc/fs/cifs/Stats | awk '{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/){print $i; exit}}')
[ -n "$stat_before" ] && [ -n "$stat_after" ] || _notrun "no flush counter"
if [ "$stat_after" -le "$stat_before" ]; then _fail "flush counter did not increase"; fi
echo "strictsync flush OK"
status=0; exit
