#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: mapchars allows special characters in filenames (client-side mapping)
#
# What this test validates
# - With -o mapchars, creating files containing characters typically forbidden on
#   Windows (e.g., : * ? < > |) succeeds and can be read back via the client.
# - Without mapchars, such creations may fail; this test focuses on the mapchars
#   success path and skips if unsupported by the server.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"

_register_cleanup "_test_unmount >/dev/null 2>&1"
_test_unmount >/dev/null 2>&1

BASE=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^\s*-o\s*//')
# Remove any pre-existing mapchars to avoid duplicates, then append
MO=$(echo "$BASE" | awk -F, '{out=""; for(i=1;i<=NF;i++){ if($i=="mapchars") continue; out=out (out?"," : "") $i } print out}')
[ -n "$MO" ] && MO="$MO,mapchars" || MO="mapchars"

MNT=$(mktemp -d /tmp/cifs140.map.XXXXXX) || _fail "mktemp"
_do "mount -t cifs '$TEST_DEV' '$MNT' -o '$MO'" || _notrun "mapchars not supported"

SUB="cifs140.$$.d"; mkdir -p "$MNT/$SUB" || _fail "mkdir"

# Filename with special characters; quote to avoid shell globbing
NAME="a:star*ques?lt<gt>|pipe.txt"
PATHNAME="$MNT/$SUB/$NAME"

echo "hello-mapchars" > "$PATHNAME" 2>>$seqres.full || _notrun "server refused special-char filename with mapchars"

# Verify the entry is visible with the same name and content is readable
ls -1 "$MNT/$SUB" | grep -Fx -- "$NAME" >/dev/null || _fail "created file not listed as expected name"
content=$(cat "$PATHNAME") || _fail "read back content failed"
[ "$content" = "hello-mapchars" ] || _fail "content mismatch: '$content'"

echo "mapchars special-character filename OK"

status=0
exit
