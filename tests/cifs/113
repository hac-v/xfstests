#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: delete-on-close semantics (unlink open handle)
#
# Behavior under test
# - Unlinking an open file removes the directory entry, but existing open
#   handles remain usable until close; after the last handle closes the file is
#   gone.
#
# Output
# - Stable single success line; diagnostics go to $seqres.full.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_register_cleanup "_test_unmount >/dev/null 2>&1; rm -rf \"$TEST_DIR/cifs113.$$\" >/dev/null 2>&1"

_test_unmount > /dev/null 2>&1
_do "_test_mount" || _fail "mount failed"

W="$TEST_DIR/cifs113.$$"
mkdir -p "$W" || _fail "mkdir workspace failed"

# Open and write, keep handle open in this process
exec 3>"$W/a" || _fail "open a for write failed"
printf "hello" >&3 || _fail "initial write via fd failed"

# Unlink path while handle is open
rm -f "$W/a" || _fail "unlink a failed"

# Write should still succeed via the open handle
printf "!" >&3 || _fail "write via open handle after unlink failed"

# After unlink, the path should not exist (if it does, log only)
if [ -e "$W/a" ]; then
    echo "[diag] after unlink, $W/a still exists in dir listing (server delayed deletion?)" >> $seqres.full
fi

# Close handle; file must be gone
exec 3>&-
if [ -e "$W/a" ]; then
    _fail "file still present after closing last handle"
fi

echo "delete-on-close basic OK"

status=0
exit
