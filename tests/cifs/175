#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: Multi-address IP failover (mount.cifs ip=addr1,addr2 list)
#
# Objective:
#   Verify that when mounting with an ip= option containing an unreachable
#   first address followed by the real server address, the mount succeeds and
#   /proc/mounts reflects the real (second) IP chosen.
#
# Method:
#   1. Derive server hostname from $TEST_DEV (//host/share)
#   2. Resolve first usable IPv4 address (REALIP)
#   3. Attempt mount to a temp dir with ip=BAD,REALIP where BAD is 203.0.113.1
#      (TEST-NET-3, should be unreachable) unless it equals REALIP; if so use
#      198.51.100.1 instead.
#   4. Confirm mount succeeds.
#   5. Confirm /proc/mounts entry for the temp mount contains ip=REALIP.
#   6. Success message.
#
# Skip conditions:
#   - Non-CIFS FSTYP
#   - Not root (needs separate mount)
#   - Hostname parse or IP resolution failure
#   - No IPv4 address resolved
#
# Notes:
#   - We do not force ECONNREFUSED vs EHOSTUNREACH; any failure of first IP
#     that still allows fallback is acceptable.
#   - If kernel does not rewrite ip= to the chosen IP (edge case), we log
#     diagnostics and fail to highlight deviation.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"

host=$(echo "$TEST_DEV" | sed -n 's#^//\([^/]*\)/.*#\1#p')
[ -n "$host" ] || _notrun "could not parse host"

# Resolve first IPv4 address for host
REALIP=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$REALIP" ] || _notrun "resolve IPv4 failed"

BAD=203.0.113.1  # TEST-NET-3 reserved documentation network
if [ "$BAD" = "$REALIP" ]; then BAD=198.51.100.1; fi  # alternate TEST-NET-2
[ "$BAD" != "$REALIP" ] || _notrun "testnet addresses collide with server"

MNT2=$(mktemp -d /tmp/cifs175.mnt.XXXXXX) || _fail "mktemp"
_register_cleanup "umount $MNT2 >/dev/null 2>&1 || true; rmdir $MNT2 >/dev/null 2>&1 || true"

# Derive base mount options (exclude leading -o, strip existing ip= if present)
base_opts=${MOUNT_OPTIONS#-o}
if [ -z "$base_opts" ]; then
    base_opts=$(awk -v mnt="$TEST_DIR" '$2==mnt {print $4}' /proc/mounts)
fi
# remove any ip= token(s)
base_opts=$(echo "$base_opts" | sed -E 's/(^|,)ip=[^,]*//g; s/,,/,/g; s/^,//; s/,$//')

IPLIST="$BAD,$REALIP"
OPTS="ip=$IPLIST,$base_opts"
echo "cifs175: attempting mount with ip list $IPLIST (real=$REALIP bad=$BAD)" >> $seqres.full

if ! mount -t cifs "$TEST_DEV" "$MNT2" -o "$OPTS" >> $seqres.full 2>&1; then
    _fail "mount with multi-ip list failed"
fi

# Extract mounts line
mtab_line=$(grep -F " $MNT2 " /proc/mounts | head -n1)
echo "cifs175: /proc/mounts line: $mtab_line" >> $seqres.full

echo "$mtab_line" | grep -q "ip=$REALIP" || _fail "real ip not recorded in /proc/mounts (expected ip=$REALIP)"

echo "Multi-address IP failover OK"
status=0; exit
