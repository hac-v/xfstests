#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: resilience of reads, directory ops, and metadata across reconnects
#
# Summary
#   Extends sequential write coverage (cifs/184) by forcing TCP disconnects
#   during three additional operation classes—large sequential reads,
#   directory churn, and metadata updates—and ensuring each operation family
#   completes successfully with consistent end state.
#
# Phases
#   1. Prepare deterministic data and helpers.
#   2. Launch a large reader, drop connectivity mid-stream, verify it
#      completes and the file hash matches original content.
#   3. Run directory rename churn while dropping connectivity, confirm final
#      inventory matches expectation.
#   4. Toggle metadata (mode + mtime) in a loop whilst dropping connectivity,
#      then ensure the final metadata matches the planned target.

. ./common/preamble
. ./common/rc
_begin_fstest auto stress

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/DebugData ] || _notrun "DebugData unavailable"

command -v iptables >/dev/null 2>&1 || _notrun "iptables required"
command -v sha256sum >/dev/null 2>&1 || _notrun "sha256sum required"
command -v python3 >/dev/null 2>&1 || _notrun "python3 required"
command -v gcc >/dev/null 2>&1 || _notrun "gcc required"

host=$(echo "$TEST_DEV" | sed -n 's#^//\([^/]*\)/.*#\1#p')
[ -n "$host" ] || _notrun "parse host failed"
server_ip=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$server_ip" ] || _notrun "resolve server ip failed"

DROP_SECS=${CIFS192_DROP_SECS:-4}
READ_MB=${CIFS192_READ_MB:-128}
DIR_FILES=${CIFS192_DIR_FILES:-80}
META_LOOPS=${CIFS192_META_LOOPS:-120}

case "$READ_MB" in ''|*[^0-9]*) _notrun "READ_MB must be integer" ;; esac
case "$DIR_FILES" in ''|*[^0-9]*) _notrun "DIR_FILES must be integer" ;; esac
case "$META_LOOPS" in ''|*[^0-9]*) _notrun "META_LOOPS must be integer" ;; esac
[ "$READ_MB" -gt 0 ] || _notrun "READ_MB must be >0"
[ "$DIR_FILES" -gt 0 ] || _notrun "DIR_FILES must be >0"
[ "$META_LOOPS" -gt 0 ] || _notrun "META_LOOPS must be >0"

WORKDIR="$TEST_DIR/cifs192.$$.work"
rm -rf "$WORKDIR" 2>/dev/null || true
mkdir -p "$WORKDIR" || _fail "mkdir workdir"

cleanup()
{
    iptables -D OUTPUT -d "$server_ip" -p tcp --dport 445 -j DROP >/dev/null 2>&1 || true
    iptables -D INPUT -s "$server_ip" -p tcp --sport 445 -j DROP >/dev/null 2>&1 || true
    rm -rf "$WORKDIR" >/dev/null 2>&1 || true
    rm -f "$READER_SRC" "$READER_BIN" >/dev/null 2>&1 || true
}
_register_cleanup cleanup

READER_SRC=${TMPDIR:-/tmp}/cifs192_reader.c
READER_BIN=${TMPDIR:-/tmp}/cifs192_reader

cat >"$READER_SRC" <<'EOF'
#define _GNU_SOURCE
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(int argc, char **argv)
{
    if (argc != 2) {
        fprintf(stderr, "usage: %s <file>\n", argv[0]);
        return 2;
    }
    int fd = open(argv[1], O_RDONLY);
    if (fd < 0) {
        perror("open");
        return 1;
    }
    const size_t buf_sz = 1024 * 1024;
    unsigned char *buf = malloc(buf_sz);
    if (!buf) {
        perror("malloc");
        close(fd);
        return 1;
    }
    off_t off = 0;
    for (;;) {
        ssize_t rc = pread(fd, buf, buf_sz, off);
        if (rc < 0) {
            if (errno == EINTR)
                continue;
            perror("pread");
            free(buf);
            close(fd);
            return 1;
        }
        if (rc == 0)
            break;
        off += rc;
    }
    free(buf);
    if (close(fd) < 0) {
        perror("close");
        return 1;
    }
    return 0;
}
EOF

gcc -O2 -Wall -o "$READER_BIN" "$READER_SRC" >>$seqres.full 2>&1 || _fail "compile reader"

DATA_FILE="$WORKDIR/large.bin"

CIFS192_READ_MB=$READ_MB CIFS192_FILE=$DATA_FILE python3 - <<'PY'
import os
import random
from pathlib import Path

size_mb = int(os.environ['CIFS192_READ_MB'])
path = Path(os.environ['CIFS192_FILE'])
path.parent.mkdir(parents=True, exist_ok=True)
total = size_mb * 1024 * 1024
chunk = 1024 * 1024
rng = random.Random(1234)
with open(path, 'wb', buffering=0) as f:
    written = 0
    while written < total:
        block = bytearray(rng.randrange(0, 256) for _ in range(min(chunk, total - written)))
        f.write(block)
        written += len(block)
PY

sha_orig=$(sha256sum "$DATA_FILE" | awk '{print $1}')

force_drop()
{
    iptables -I OUTPUT -d "$server_ip" -p tcp --dport 445 -j DROP >>$seqres.full 2>&1 || return 1
    iptables -I INPUT -s "$server_ip" -p tcp --sport 445 -j DROP >>$seqres.full 2>&1 || return 1
    sleep "$DROP_SECS"
    iptables -D OUTPUT -d "$server_ip" -p tcp --dport 445 -j DROP >>$seqres.full 2>&1 || true
    iptables -D INPUT -s "$server_ip" -p tcp --sport 445 -j DROP >>$seqres.full 2>&1 || true
    return 0
}

# Phase 1: Sequential read during disconnect
"$READER_BIN" "$DATA_FILE" >>$seqres.full 2>&1 &
reader_pid=$!
sleep 1
force_drop || _notrun "iptables manipulation failed"
wait $reader_pid
[ $? -eq 0 ] || _fail "reader failed after reconnect"

sha_post=$(sha256sum "$DATA_FILE" | awk '{print $1}')
[ "$sha_post" = "$sha_orig" ] || _fail "file hash changed after read phase"

# Phase 2: Directory rename churn across reconnect
DIR_A="$WORKDIR/dir_a"
DIR_B="$WORKDIR/dir_b"
rm -rf "$DIR_A" "$DIR_B" 2>/dev/null || true
mkdir -p "$DIR_A" || _fail "mkdir dir_a"
mkdir -p "$DIR_B" || _fail "mkdir dir_b"

for i in $(seq 1 "$DIR_FILES"); do
    printf 'payload%04d' "$i" >"$DIR_A/file.$i" || _fail "seed dir file $i"
done

CIFS192_DIR_A=$DIR_A CIFS192_DIR_B=$DIR_B CIFS192_DIR_FILES=$DIR_FILES python3 - <<'PY' >>$seqres.full 2>&1 &
import os
import time
import errno
from pathlib import Path

dir_a = Path(os.environ['CIFS192_DIR_A'])
dir_b = Path(os.environ['CIFS192_DIR_B'])
count = int(os.environ['CIFS192_DIR_FILES'])

for i in range(1, count + 1):
    # move to dir_b
    src = dir_a / f"file.{i}"
    dst = dir_b / f"file.{i}"
    while True:
        try:
            os.replace(src, dst)
            break
        except OSError as e:
            if e.errno in (errno.EIO, errno.ESTALE, errno.ENOTCONN):
                time.sleep(0.5)
                continue
            raise

for i in range(1, count + 1):
    # rename back into dir_a with new name
    src = dir_b / f"file.{i}"
    dst = dir_a / f"renamed.{i}"
    while True:
        try:
            os.replace(src, dst)
            break
        except OSError as e:
            if e.errno in (errno.EIO, errno.ESTALE, errno.ENOTCONN):
                time.sleep(0.5)
                continue
            raise
PY

dir_pid=$!
sleep 1
force_drop || _notrun "iptables manipulation failed"
wait $dir_pid
[ $? -eq 0 ] || _fail "directory churn failed"

expected_count=$DIR_FILES
actual_count=$(find "$DIR_A" -maxdepth 1 -type f -name 'renamed.*' | wc -l)

if [ "$actual_count" -ne "$expected_count" ]; then
    echo "cifs192: expected $expected_count renamed files, saw $actual_count" >>$seqres.full
    _fail "directory content mismatch"
fi

# Phase 3: Metadata toggles across reconnect
META_FILE="$WORKDIR/meta.txt"
printf 'metadata test' >"$META_FILE" || _fail "seed meta file"

CIFS192_META_FILE=$META_FILE CIFS192_META_LOOPS=$META_LOOPS python3 - <<'PY' >>$seqres.full 2>&1 &
import os
import time
import errno
from pathlib import Path

meta_path = Path(os.environ['CIFS192_META_FILE'])
loops = int(os.environ['CIFS192_META_LOOPS'])

mode_a = 0o640
mode_b = 0o600
now = int(time.time())

for i in range(loops):
    target_mode = mode_a if i % 2 == 0 else mode_b
    target_time = now + i
    while True:
        try:
            os.chmod(meta_path, target_mode)
            os.utime(meta_path, (target_time, target_time))
            break
        except OSError as e:
            if e.errno in (errno.EIO, errno.ESTALE, errno.ENOTCONN):
                time.sleep(0.5)
                continue
            raise

with open(meta_path, 'a', encoding='utf-8') as fh:
    fh.write('\nfinal marker\n')
PY

meta_pid=$!
sleep 1
force_drop || _notrun "iptables manipulation failed"
wait $meta_pid
[ $? -eq 0 ] || _fail "metadata loop failed"

final_mode=$(stat -c %a "$META_FILE")

if [ $((META_LOOPS % 2)) -eq 0 ]; then
    expected_mode=600
else
    expected_mode=640
fi

if [ "$final_mode" -ne "$expected_mode" ]; then
    echo "cifs192: expected mode $expected_mode got $final_mode" >>$seqres.full
    _fail "mode mismatch after metadata phase"
fi

final_count=$(grep -c 'final marker' "$META_FILE")
[ "$final_count" -ge 1 ] || _fail "metadata file append missing"

echo "Read, directory, and metadata operations recovered after reconnect OK"
status=0
exit
