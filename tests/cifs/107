#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: verify max_channels=2 is honored when multichannel is requested
#
# Behavior under test
# - Mount with -o multichannel,max_channels=2 and verify the client reports
#   exactly 2 allocated channels for the server connection in DebugData.
# - Also verify there are at least 2 TCP sockets to the server.
#
# Skip policy
# - If DebugData lacks interfaces for this host or shows <2 channels repeatedly,
#   skip (server/kernel may not support multichannel).

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_host_from_unc() { echo "$1" | sed -E 's#^//([^/]+)/.*#\1#'; }
_share_from_unc() { echo "$1" | sed -E 's#^//[^/]+/([^/]+).*#\1#'; }
_unc_windows() { local h=$(_host_from_unc "$1"); local s=$(_share_from_unc "$1"); printf "\\\\%s\\%s" "$h" "$s"; }

HOST=$(_host_from_unc "$TEST_DEV")
UNCW=$(_unc_windows "$TEST_DEV")
[ -n "$HOST" ] || _notrun "could not derive host"

_dd_allocated_channels_sum_for_host()
{
    local host="$1"; local snap
    snap=$(cat /proc/fs/cifs/DebugData 2>/dev/null)
    echo "$snap" >> $seqres.full
    echo "$snap" | awk -v HOST="$host" '
        BEGIN { tl=tolower(HOST); in_block=0; target=0; in_if=0; sum=0; printed=0 }
        /^[[:space:]]*[0-9]+[)].*ConnectionId:/ {
            if (in_block==1 && target==1 && in_if==1) { print sum; printed=1; exit }
            in_block=1; target=0; in_if=0; sum=0; next
        }
        in_block==1 {
            line=tolower($0)
            if (index(line, tl)>0) target=1
            if ($1=="Server" && $2=="interfaces:") { in_if=1; next }
            if ((NF==0 || ($0 ~ /^[[:space:]]*[0-9]+[)].*ConnectionId:/)) && target==1 && in_if==1) { print sum; printed=1; exit }
            if (in_if==1 && $1=="Allocated" && $2=="channels:") { n=$3+0; sum+=n }
        }
        END { if (printed==0 && in_block==1 && target==1 && in_if==1) print sum }
    '
}

_resolve_host_ips() { getent ahosts "$1" | awk '{print $1}' | sort -u; }

_tcp_conns_to_host_count()
{
    local host="$1" ips
    ips=$(_resolve_host_ips "$host")
    [ -n "$ips" ] || { echo 0; return; }
    if command -v ss >/dev/null 2>&1; then
        ss -tanH 2>/dev/null | awk -v IPS="$(echo $ips)" '
            BEGIN { split(IPS,a," "); }
            { r=$5; if (r ~ /:445$/ || r ~ /:139$/) { for (i in a) if (index(r,a[i])>0) { c++; break } } }
            END { print c+0 }
        '
    else
        netstat -tan 2>/dev/null | sed '1,2d' | awk -v IPS="$(echo $ips)" '
            BEGIN { split(IPS,a," "); }
            { r=$5; if (r ~ /:445$/ || r ~ /:139$/) { for (i in a) if (index(r,a[i])>0) { c++; break } } }
            END { print c+0 }
        '
    fi
}

_register_cleanup "_test_unmount >/dev/null 2>&1; rm -f \"$TEST_DIR/.cifs107.$$\" >/dev/null 2>&1; rm -f \"$TEST_DIR/.cifs107.$$.bin\" >/dev/null 2>&1"

# Request exactly two channels
_test_unmount > /dev/null 2>&1
_do "_test_mount -o multichannel,max_channels=2" || _fail "mount TEST_DEV with multichannel,max_channels=2 failed"

# Trigger activity
echo 1 > "$TEST_DIR/.cifs107.$$" 2>/dev/null || true
dd if=/dev/zero of="$TEST_DIR/.cifs107.$$.bin" bs=1M count=4 oflag=direct status=none 2>>$seqres.full || true

# Poll for DebugData sum
tries=30
sum=""
while [ $tries -gt 0 ]; do
    sum=$(_dd_allocated_channels_sum_for_host "$HOST" | awk 'NR==1{print $1+0}')
    echo "max_channels: DebugData sum='${sum}' tries=$tries" >> $seqres.full
    [ -n "$sum" ] && [ "$sum" -ge 1 ] && break
    tries=$((tries-1)); sleep 0.2
done

[ -n "$sum" ] || _notrun "DebugData lacks Server interfaces for $UNCW"

if [ "$sum" -lt 2 ]; then
    _notrun "multichannel appears unsupported: allocated channels=$sum (<2) for $UNCW"
fi

if [ "$sum" -ne 2 ]; then
    _fail "expected DebugData allocated channels sum=2, got $sum"
fi

# Also check sockets
tries=20
sc=0
while [ $tries -gt 0 ]; do
    sc=$(_tcp_conns_to_host_count "$HOST")
    echo "sockets: count=$sc (tries=$tries)" >> $seqres.full
    [ "$sc" -ge 2 ] && break
    tries=$((tries-1)); sleep 0.3
done

[ "$sc" -ge 2 ] || _fail "expected >=2 TCP sockets to $HOST, got $sc"
if [ "$sc" -lt "$sum" ]; then
    _fail "TCP sockets ($sc) < DebugData channels ($sum)"
fi

echo "Max channels honored (2) OK"

status=0
exit
