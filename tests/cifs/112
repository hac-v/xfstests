#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: timestamps (mtime/ctime) set and update semantics
#
# Behavior under test
# - Setting mtime via touch is honored by server (seconds granularity).
# - Subsequent content write updates mtime (and typically ctime).
#
# Output
# - Stable single success line; diagnostics go to $seqres.full.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

_register_cleanup "_test_unmount >/dev/null 2>&1; rm -rf \"$TEST_DIR/cifs112.$$\" >/dev/null 2>&1"

_test_unmount > /dev/null 2>&1
_do "_test_mount" || _fail "mount failed"

W="$TEST_DIR/cifs112.$$"
mkdir -p "$W" || _fail "mkdir workspace failed"
printf "x" > "$W/f" || _fail "create file failed"

# Capture initial times
m0=$(stat -c %Y "$W/f") || _fail "stat mtime failed"
c0=$(stat -c %Z "$W/f") || _fail "stat ctime failed"

# Set mtime to a known value (UTC 2024-01-02 03:04:05)
TZ=UTC touch -m -t 202401020304.05 "$W/f" || _fail "touch set mtime failed"
m1=$(stat -c %Y "$W/f") || _fail "stat mtime after set failed"
ref=$(date -u -d '2024-01-02 03:04:05' +%s 2>/dev/null || echo 1704164645)
[ "$m1" = "$ref" ] || _fail "mtime not set as requested: got $m1 expected $ref"

# Ensure writes update mtime; sleep to avoid same-second rounding
sleep 1
printf "!" >> "$W/f" || _fail "append failed"
m2=$(stat -c %Y "$W/f") || _fail "stat mtime after write failed"
[ "$m2" -gt "$m1" ] || _fail "mtime did not advance after write"

# ctime typically advances; log if not, but don't fail for servers without ctime updates
c1=$(stat -c %Z "$W/f") || _fail "stat ctime after write failed"
if [ "$c1" -le "$c0" ]; then
    echo "[diag] ctime did not advance (server may not update ctime on write)" >> $seqres.full
fi

echo "timestamps basic OK"

status=0
exit
