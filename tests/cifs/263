#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: CIFS_IOC_GET_MNT_INFO and CIFS_IOC_GET_TCON_INFO ioctls
#
# Kernel code exercised:
# - ioctl.c: CIFS_IOC_GET_MNT_INFO handler — returns smb_mnt_fs_info struct
# - ioctl.c: CIFS_IOC_GET_TCON_INFO handler — returns smb_tcon_info struct
# - These are diagnostic ioctls that return mount and tree-connect metadata
# - Verify the ioctls succeed and return non-empty data

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"

command -v python3 >/dev/null 2>&1 || _notrun "requires python3"

W="$TEST_DIR/cifs263.$$"
_register_cleanup "rm -rf '$W' >/dev/null 2>&1 || true"
mkdir -p "$W" || _fail "mkdir workspace failed"

F="$W/info_test"
echo "info" > "$F" || _fail "create file failed"

# --- Test 1: CIFS_IOC_GET_MNT_INFO ---
# struct smb_mnt_fs_info is defined in cifsglob.h
# CIFS_IOC_GET_MNT_INFO = _IOW(0xcf, 0x0a, struct smb_mnt_fs_info)
python3 -c "
import fcntl, struct, os, sys

# CIFS_IOC_GET_MNT_INFO: try the known ioctl numbers
# _IOW(0xcf, 0x0a, ...) — size depends on struct size
# struct smb_mnt_fs_info is ~152 bytes
IOCTL_NUMS = [
    0x4098cf0a,  # _IOW with 152 bytes
    0x40a0cf0a,  # _IOW with 160 bytes
    0x0000cf0a,  # _IO  bare
]

fd = os.open('$F', os.O_RDONLY)
success = False
try:
    for ioctl_num in IOCTL_NUMS:
        try:
            buf = bytearray(256)
            fcntl.ioctl(fd, ioctl_num, buf)
            # Parse protocol_id (first 4 bytes)
            proto = struct.unpack_from('<I', buf, 0)[0]
            print(f'GET_MNT_INFO (0x{ioctl_num:08x}): proto=0x{proto:08x}', file=sys.stderr)
            success = True
            # Parse more fields if protocol looks valid
            if proto > 0:
                tcon_id = struct.unpack_from('<I', buf, 4)[0]
                print(f'  tcon_id={tcon_id}', file=sys.stderr)
            break
        except OSError as e:
            print(f'GET_MNT_INFO 0x{ioctl_num:08x}: {e}', file=sys.stderr)
            continue

    if not success:
        print('GET_MNT_INFO: no ioctl number worked', file=sys.stderr)
        sys.exit(77)
finally:
    os.close(fd)
" 2>>"$seqres.full"
rc1=$?
if [ $rc1 -eq 77 ]; then
    echo "cifs263: [skip] GET_MNT_INFO not supported" >> "$seqres.full"
else
    echo "cifs263: GET_MNT_INFO OK" >> "$seqres.full"
fi

# --- Test 2: CIFS_IOC_GET_TCON_INFO ---
python3 -c "
import fcntl, struct, os, sys

# CIFS_IOC_GET_TCON_INFO — try known ioctl numbers
IOCTL_NUMS = [
    0x4008cf0b,  # _IOW with 8 bytes
    0x0000cf0b,  # _IO bare
    0x4020cf0b,  # _IOW with 32 bytes
]

fd = os.open('$F', os.O_RDONLY)
success = False
try:
    for ioctl_num in IOCTL_NUMS:
        try:
            buf = bytearray(256)
            fcntl.ioctl(fd, ioctl_num, buf)
            tid = struct.unpack_from('<I', buf, 0)[0]
            print(f'GET_TCON_INFO (0x{ioctl_num:08x}): tree_id={tid}', file=sys.stderr)
            success = True
            break
        except OSError as e:
            print(f'GET_TCON_INFO 0x{ioctl_num:08x}: {e}', file=sys.stderr)
            continue

    if not success:
        print('GET_TCON_INFO: no ioctl number worked', file=sys.stderr)
        sys.exit(77)
finally:
    os.close(fd)
" 2>>"$seqres.full"
rc2=$?
if [ $rc2 -eq 77 ]; then
    echo "cifs263: [skip] GET_TCON_INFO not supported" >> "$seqres.full"
else
    echo "cifs263: GET_TCON_INFO OK" >> "$seqres.full"
fi

# --- Test 3: smbinfo tool queries (if available, exercises CIFS_QUERY_INFO) ---
if command -v smbinfo >/dev/null 2>&1; then
    echo "cifs263: smbinfo queries:" >> "$seqres.full"

    for cmd in fileid fsctlgetobjid secdesc keys; do
        out=$(smbinfo "$cmd" "$F" 2>&1) || true
        echo "  smbinfo $cmd: $(echo "$out" | head -2)" >> "$seqres.full"
    done

    echo "cifs263: smbinfo OK" >> "$seqres.full"
else
    echo "cifs263: [skip] smbinfo not installed" >> "$seqres.full"
fi

echo "CIFS_IOC_GET_MNT/TCON_INFO OK"

status=0
exit
