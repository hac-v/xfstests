#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: persistent/durable handle survives reconnect
#
# Keep a file descriptor open, force a TCP reconnect window, and validate that
# the open_files entry for that fd has a non-zero persistent fid both before
# and after reconnect. Skip if backend does not expose persistent handles.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ "$(id -u)" = 0 ] || _notrun "root required"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ -r /proc/fs/cifs/open_files ] || _notrun "open_files unavailable"
command -v iptables >/dev/null 2>&1 || _notrun "iptables required"

host=$(echo "$TEST_DEV" | sed -E 's#^//([^/]+)/.*#\1#')
[ -n "$host" ] || _notrun "parse host failed"
server_ip=$(getent ahostsv4 "$host" | awk '{print $1; exit}')
[ -n "$server_ip" ] || _notrun "resolve IPv4 failed"

DIR="$TEST_DIR/cifs179.dir"
FILE="$DIR/holdfile"
mkdir -p "$DIR" || _fail "mkdir"
: > "$FILE" || _fail "create file"

_register_cleanup "iptables -D OUTPUT -d $server_ip -p tcp --dport 445 -j DROP 2>/dev/null || true; iptables -D INPUT -s $server_ip -p tcp --sport 445 -j DROP 2>/dev/null || true; kill $HOLDER_PID >/dev/null 2>&1 || true; rm -rf '$DIR' >/dev/null 2>&1 || true"

# Holder keeps fd 9 open and appends periodically.
(
    exec 9>>"$FILE" || exit 1
    i=0
    while true; do
        i=$((i+1))
        printf "tick-%d\n" "$i" >&9 || exit 2
        sleep 0.2
    done
) >>$seqres.full 2>&1 &
HOLDER_PID=$!
sleep 1
kill -0 $HOLDER_PID 2>/dev/null || _fail "holder exited early"

parse_pfid_for_pid_file() {
    awk -v pid="$1" -v file="$2" '
        $6 == pid && ($8 == file || index($8, file)) {
            print $3
            exit
        }
    ' /proc/fs/cifs/open_files
}

wait_pfid() {
    local pid="$1"
    local file="$2"
    local base
    base=$(basename "$file")
    local tries=${3:-50}
    local pfid=""
    while [ "$tries" -gt 0 ]; do
        pfid=$(parse_pfid_for_pid_file "$pid" "$base")
        if [ -n "$pfid" ]; then
            echo "$pfid"
            return 0
        fi
        sleep 0.2
        tries=$((tries-1))
    done
    return 1
}

is_zero_pfid() {
    local v=$(echo "$1" | tr 'A-Z' 'a-z')
    [ "$v" = "0" ] || [ "$v" = "0x0" ] || [ "$v" = "0000000000000000" ] || [ "$v" = "0x0000000000000000" ]
}

PFID1=$(wait_pfid "$HOLDER_PID" "$FILE" 60) || {
    kill $HOLDER_PID >/dev/null 2>&1 || true
    _notrun "no open_files entry for holder"
}
if is_zero_pfid "$PFID1"; then
    kill $HOLDER_PID >/dev/null 2>&1 || true
    _notrun "persistent/durable handle not exposed"
fi

echo "cifs179: pre-reconnect persistent_fid=$PFID1" >>$seqres.full

iptables -I OUTPUT -d "$server_ip" -p tcp --dport 445 -j DROP >>$seqres.full 2>&1 || _notrun "iptables insert failed"
iptables -I INPUT -s "$server_ip" -p tcp --sport 445 -j DROP >>$seqres.full 2>&1 || _notrun "iptables insert failed"
sleep 3
iptables -D OUTPUT -d "$server_ip" -p tcp --dport 445 -j DROP >>$seqres.full 2>&1 || true
iptables -D INPUT -s "$server_ip" -p tcp --sport 445 -j DROP >>$seqres.full 2>&1 || true
sleep 2

kill -0 $HOLDER_PID 2>/dev/null || _fail "holder died during reconnect"

PFID2=$(wait_pfid "$HOLDER_PID" "$FILE" 80) || _fail "missing open_files entry after reconnect"
is_zero_pfid "$PFID2" && _fail "persistent fid became zero after reconnect"

echo "cifs179: post-reconnect persistent_fid=$PFID2" >>$seqres.full

kill $HOLDER_PID >/dev/null 2>&1 || true

echo "persistent/durable handle reconnect OK"
status=0
exit
