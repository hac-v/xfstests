#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
#
# CIFS: modefromsid — persist POSIX mode bits in Windows SIDs
#
# Behavior under test
# - Mount with modefromsid: mode bits are stored as a special SID in the
#   file's security descriptor, so chmod values survive across remounts.
# - chmod 0644 → remount → stat shows 644.
# - chmod 0755 → remount → stat shows 755.
# - Directory mode bits also persist.
# - Skip if modefromsid mount option is not supported.
#
# Output
# - Single success line; diagnostics go to $seqres.full.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ "$(id -u)" = 0 ] || _notrun "root required"

M1=""
_cleanup_221() {
    [ -n "$M1" ] && _do "umount -l '$M1'" >/dev/null 2>&1 || true
    [ -n "$M1" ] && rmdir "$M1" >/dev/null 2>&1 || true
}
_register_cleanup _cleanup_221

_test_unmount >/dev/null 2>&1

_strip_mode_opts() {
    echo "$1" | awk -F, '{
        out=""
        for(i=1;i<=NF;i++){
            if($i ~ /^(modefromsid|file_mode=|dir_mode=|noperm|perm|cifsacl|nounix|unix)/) continue
            out = out (out ? "," : "") $i
        }
        print out
    }'
}

BASE=$(echo "${MOUNT_OPTIONS:-}" | sed -e 's/^\s*-o\s*//')
STRIPPED=$(_strip_mode_opts "$BASE")
MO="$STRIPPED"
[ -n "$MO" ] && MO="$MO,modefromsid" || MO="modefromsid"

M1=$(mktemp -d /tmp/cifs221.XXXXXX) || _fail "mktemp failed"
if ! _do "mount -t cifs '$TEST_DEV' '$M1' -o '$MO'" 2>>"$seqres.full"; then
    rmdir "$M1" 2>/dev/null
    M1=""
    _notrun "modefromsid mount not supported"
fi

SUB="cifs221.$$.d"
mkdir -p "$M1/$SUB" || _fail "mkdir workspace failed"

# --- Test 1: chmod on file persists ---
F="$M1/$SUB/modefile"
echo "modefromsid_test" > "$F" || _fail "create file failed"

chmod 0644 "$F" 2>>"$seqres.full" || _fail "chmod 0644 failed"
m1=$(stat -c %a "$F")
echo "cifs221: after chmod 644, mode=$m1" >> "$seqres.full"
[ "$m1" = "644" ] || _fail "chmod 644 not reflected: got $m1"

chmod 0755 "$F" 2>>"$seqres.full" || _fail "chmod 0755 failed"
m2=$(stat -c %a "$F")
echo "cifs221: after chmod 755, mode=$m2" >> "$seqres.full"
[ "$m2" = "755" ] || _fail "chmod 755 not reflected: got $m2"

# --- Test 2: mode persists across unmount/remount ---
sync
_do "umount '$M1'" 2>>"$seqres.full" || _fail "unmount for remount failed"
_do "mount -t cifs '$TEST_DEV' '$M1' -o '$MO'" 2>>"$seqres.full" || _fail "remount failed"

m3=$(stat -c %a "$M1/$SUB/modefile")
echo "cifs221: after remount, mode=$m3 (expect 755)" >> "$seqres.full"
[ "$m3" = "755" ] || _fail "mode not persisted after remount: expected 755 got $m3"

echo "cifs221: file mode persistence OK" >> "$seqres.full"

# --- Test 3: directory mode ---
D="$M1/$SUB/modedir"
mkdir "$D" 2>>"$seqres.full" || _fail "mkdir modedir failed"
chmod 0700 "$D" 2>>"$seqres.full" || _fail "chmod dir 700 failed"
dm=$(stat -c %a "$D")
echo "cifs221: dir mode=$dm (expect 700)" >> "$seqres.full"
[ "$dm" = "700" ] || _fail "dir chmod 700 not reflected: got $dm"

chmod 0750 "$D" 2>>"$seqres.full" || _fail "chmod dir 750 failed"

sync
_do "umount '$M1'" 2>>"$seqres.full" || _fail "unmount for dir remount failed"
_do "mount -t cifs '$TEST_DEV' '$M1' -o '$MO'" 2>>"$seqres.full" || _fail "dir remount failed"

dm2=$(stat -c %a "$M1/$SUB/modedir")
echo "cifs221: dir mode after remount=$dm2 (expect 750)" >> "$seqres.full"
[ "$dm2" = "750" ] || _fail "dir mode not persisted after remount: expected 750 got $dm2"

echo "posix modefromsid OK"

status=0
exit
