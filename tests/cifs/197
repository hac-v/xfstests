#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# CIFS: nosuid prevents setuid binaries from elevating privileges
#
# Ensures remounting with nosuid clears effective UID changes from setuid
# helpers and that restoring original mount options re-enables setuid
# elevation.

. ./common/preamble
. ./common/rc
_begin_fstest auto quick

[ "$FSTYP" = "cifs" ] || _notrun "requires CIFS"
[ -n "$TEST_DEV" ] || _notrun "TEST_DEV not set"
[ -n "$TEST_DIR" ] || _notrun "TEST_DIR not set"
[ "$(id -u)" = 0 ] || _notrun "root required"
command -v gcc >/dev/null 2>&1 || _notrun "gcc required"

mount_line=$(awk -v mnt="$TEST_DIR" '$2==mnt {print; exit}' /proc/mounts)
[ -n "$mount_line" ] || _notrun "mount entry not found"
orig_opts=$(echo "$mount_line" | awk '{print $4}')

has_flag() {
    echo "$1" | tr ',' '\n' | grep -qx "$2"
}

strip_flag() {
    echo "$1" | awk -v flag="$2" -F, '{out=""; for(i=1;i<=NF;i++){if($i==flag || $i=="") continue; if(length(out)) out=out","$i; else out=$i;} print out}'
}

append_flag() {
    local base="$1"
    local flag="$2"
    if [ -z "$base" ]; then
        printf '%s' "$flag"
    else
        printf '%s,%s' "$base" "$flag"
    fi
}

orig_has_nosuid=0
has_flag "$orig_opts" "nosuid" && orig_has_nosuid=1
orig_has_suid=0
has_flag "$orig_opts" "suid" && orig_has_suid=1

if [ $orig_has_nosuid -eq 1 ]; then
    suid_opts=$(append_flag "$(strip_flag "$orig_opts" "nosuid")" "suid")
    nosuid_opts="$orig_opts"
else
    if [ $orig_has_suid -eq 1 ]; then
        suid_opts="$orig_opts"
    else
        suid_opts=$(append_flag "$orig_opts" "suid")
    fi
    nosuid_opts=$(append_flag "$(strip_flag "$orig_opts" "suid")" "nosuid")
fi

echo "cifs197: orig=$orig_opts suid=$suid_opts nosuid=$nosuid_opts" >>$seqres.full

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
HELPER_SRC="$SCRIPT_DIR/src/cifs197_setuid.c"
HELPER_BIN=${TMPDIR:-/tmp}/cifs197_setuid.$$

gcc -O2 -Wall -o "$HELPER_BIN" "$HELPER_SRC" >/tmp/cifs197.build 2>&1 || {
    cat /tmp/cifs197.build >>$seqres.full 2>/dev/null || true
    rm -f /tmp/cifs197.build "$HELPER_BIN"
    _notrun "failed to build helper"
}
rm -f /tmp/cifs197.build

clean_helper() {
    mount -o "remount,$orig_opts" "$TEST_DIR" >/dev/null 2>&1 || true
    rm -rf "$WORKDIR" "$HELPER_BIN"
}
_register_cleanup clean_helper

WORKDIR="$TEST_DIR/cifs197.$$"
mkdir -p "$WORKDIR" || _fail "mkdir workdir"
chmod 755 "$WORKDIR" || true

HELPER_PATH="$WORKDIR/helper"
install -m 4555 "$HELPER_BIN" "$HELPER_PATH" || _notrun "failed to deploy helper"

perms=$(stat -c %a "$HELPER_PATH" 2>/dev/null)
case "$perms" in
4755|4754|4750|4711|4710|4700) ;; # ensure setuid bit set
*)
    echo "cifs197: helper perms=$perms" >>$seqres.full
    _notrun "setuid bit stripped by server"
    ;;
esac

RUN_USER=nobody
id "$RUN_USER" >/dev/null 2>&1 || _notrun "user $RUN_USER missing"

if command -v runuser >/dev/null 2>&1; then
    run_as_user() { runuser -u "$RUN_USER" -- "$@"; }
elif command -v sudo >/dev/null 2>&1; then
    run_as_user() { sudo -u "$RUN_USER" "$@"; }
else
    _notrun "runuser/sudo unavailable for user switching"
fi

run_helper() {
    run_as_user "$HELPER_PATH"
}

# Baseline execution (enable suid if necessary).
if ! mount -o remount,"$suid_opts" "$TEST_DIR" >>$seqres.full 2>&1; then
    _notrun "unable to remount with suid"
fi

output=$(run_helper 2>>$seqres.full)
if ! echo "$output" | grep -q "euid=0"; then
    echo "$output" >>$seqres.full
    _notrun "setuid not effective even before nosuid"
fi

# Remount nosuid and verify helper no longer elevates.
if ! mount -o remount,"$nosuid_opts" "$TEST_DIR" >>$seqres.full 2>&1; then
    _notrun "remount nosuid unsupported"
fi

output=$(run_helper 2>>$seqres.full)
if echo "$output" | grep -q "euid=0"; then
    echo "$output" >>$seqres.full
    _fail "helper retained setuid under nosuid"
fi

# Restore original options; expect setuid to work again.
if ! mount -o remount,"$suid_opts" "$TEST_DIR" >>$seqres.full 2>&1; then
    _fail "remount restore failed"
fi

output=$(run_helper 2>>$seqres.full)
if ! echo "$output" | grep -q "euid=0"; then
    echo "$output" >>$seqres.full
    _fail "setuid helper failed after restoring mount"
fi

echo "nosuid blocks setuid, restore re-enables"
status=0
exit
